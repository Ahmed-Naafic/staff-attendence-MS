// EduTrack Staff Attendance Management System — Prisma schema
//
// Phase 9: platform foundation for the Super Admin web app — users and roles, schools and their
// owners, sign-in sessions, audit events and platform settings. Branches and their location
// history follow the Branch Management decisions (docs/business-rules.md). Staff, attendance and
// excuses are added in later phases, following the hierarchy (School → Branch → Staff) and role
// scopes in docs/architecture.md.
//
// School statuses follow the approved lifecycle: registered → ACTIVE ⇄ SUSPENDED (no approval,
// no deletion). Owner accounts are ACTIVE ⇄ SUSPENDED (Super Admin; no approval, no deletion);
// PENDING stays in AccountStatus for later account types and is never given to owners.
//
// Connection strings come from environment variables (see backend/prisma.config.js
// and backend/src/config/prisma.js). Never hardcode credentials here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN // PLATFORM scope
  OWNER // SCHOOL scope
  MANAGER // BRANCH scope
  STAFF // SELF scope
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

/// Registered schools start ACTIVE; Super Admins suspend (with a reason) and reactivate them.
enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

/// Branches have their own status, separate from their school's; a branch operates only when both are ACTIVE.
enum BranchStatus {
  ACTIVE
  SUSPENDED
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

/// Attendance statuses (approved): PRESENT and LATE are set at check-in; ABSENT and EXCUSED later.
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
}

enum AuditResult {
  SUCCESS
  FAILURE
}

/// Anyone who can sign in. Only ACTIVE accounts with a password can sign in.
model User {
  id                 String        @id @default(uuid())
  name               String
  /// Stored lower-case; the sign-in identifier for web users.
  email              String?       @unique
  phone              String?
  role               Role
  status             AccountStatus @default(ACTIVE)
  /// scrypt hash (see backend/src/features/auth/password.js). Never returned by the API.
  passwordHash       String?
  lastSignInAt       DateTime?
  /// Set while an OWNER account is SUSPENDED (cleared on reactivation); every change is also in the audit log.
  suspensionReason   String?
  suspendedAt        DateTime?
  /// Set for a new MANAGER and after their owner gives them a new temporary password: until the
  /// password is changed the API refuses everything except the password change (requireAuth).
  mustChangePassword Boolean       @default(false)
  /// For MANAGER and STAFF accounts only (required for them; a database check enforces it): their
  /// branch. The school is that branch's school. Manager assignment history is in ManagerAssignment.
  branchId           String?
  branch             Branch?       @relation("BranchManagers", fields: [branchId], references: [id], onDelete: Restrict)
  /// STAFF only (required for them): generated Staff ID, e.g. CIT-001-B001-ST001. Unique; never changed or reused.
  staffId            String?       @unique
  /// STAFF only: job title (the staff record's "Role"; not a system role).
  jobTitle           String?
  /// STAFF only (required for them): the phone's digits with a leading + kept; the staff sign-in
  /// identifier, unique among STAFF (partial unique index in the migration).
  phoneKey           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  /// For OWNER accounts: the one school they own.
  ownedSchool            School?                 @relation("SchoolOwner")
  sessions               Session[]
  auditEvents            AuditEvent[]            @relation("AuditActor")
  managerAssignments     ManagerAssignment[]
  staffAssignments       StaffAssignment[]
  attendanceEvents       AttendanceEvent[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushDevices            PushDevice[]
  pushMessages           PushMessage[]
  announcementReads      AnnouncementRead[]
  staffTransfers         StaffTransfer[]
  /// STAFF only: what they teach (TeachingAssignment), in any branch of their school.
  teachingAssignments    TeachingAssignment[]
  /// STAFF only: timetable lessons naming them as the teacher.
  timetableSlots         TimetableSlot[]
  /// STAFF only: timetable builder limits and unavailable times, fixed and draft lessons naming them.
  teacherTimetableProfiles TeacherTimetableProfile[]
  timetableFixedLessons    TimetableFixedLesson[]
  timetableDraftLessons    TimetableDraftLesson[]

  @@index([role, status])
  @@index([branchId])
}

model School {
  id                       String       @id @default(uuid())
  /// School Code, e.g. JHA-001. Unique; cannot change after registration.
  code                     String       @unique
  /// Not unique: two schools may share a name.
  name                     String
  /// City.
  location                 String
  status                   SchoolStatus @default(ACTIVE)
  description              String?
  /// Required when registering or editing through the API; empty on records created before them.
  phone                    String?
  address                  String?
  email                    String?
  website                  String?
  /// Set while SUSPENDED (cleared on reactivation); every change is also in the audit log.
  suspensionReason         String?
  suspendedAt              DateTime?
  registeredAt             DateTime     @default(now())
  /// One owner per school; an owner owns one school.
  ownerId                  String?      @unique
  owner                    User?        @relation("SchoolOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /// The last branch number given in this school. Raised only by the update that creates a branch
  /// (which locks this row), so branch codes are never repeated or reused.
  branchSequence           Int          @default(0)
  /// Student Attendance is available to this school (Super Admin; off by default). Changes are in the audit log.
  studentAttendanceEnabled Boolean      @default(false)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  auditEvents               AuditEvent[]
  branches                  Branch[]
  suspensionPeriods         SuspensionPeriod[]
  notifications             Notification[]
  announcements             AnnouncementSchool[]
  staffTransfers            StaffTransfer[]
  academicYears             AcademicYear[]
  classes                   SchoolClass[]
  sections                  Section[]
  students                  Student[]
  enrollments               Enrollment[]
  promotionBatches          PromotionBatch[]
  academicWeekdays          AcademicWeekdays[]
  calendarEntries           CalendarEntry[]
  subjects                  Subject[]
  classSubjects             ClassSubject[]
  teachingAssignments       TeachingAssignment[]
  bellSchedules             BellSchedule[]
  timetableVersions         TimetableVersion[]
  timetableSetups           TimetableSetup[]
  teacherTimetableProfiles  TeacherTimetableProfile[]
  timetableDrafts           TimetableDraft[]
  studentAttendanceSettings StudentAttendanceSettings[]
  studentAttendanceSessions StudentAttendanceSession[]
  studentExcuses            StudentExcuse[]

  @@index([status])
  @@index([location])
  @@index([registeredAt])
}

/// A branch of one school (never moved to another school, never deleted). Managed by the School Owner.
model Branch {
  id               String       @id @default(uuid())
  schoolId         String
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// Branch number within the school (1, 2, …), from School.branchSequence.
  number           Int
  /// Generated: school code + "-B" + number (at least three digits), e.g. JHA-001-B001. Immutable.
  code             String
  name             String
  /// The name compared for uniqueness: NFKC + locale-independent case folding (computed by the API).
  nameKey          String
  address          String
  city             String
  phone            String?
  status           BranchStatus @default(ACTIVE)
  /// Set while SUSPENDED (cleared on reactivation); every change is also in the audit log.
  suspensionReason String?
  suspendedAt      DateTime?
  /// The last staff number given in this branch (Staff IDs); raised only by the update that creates a
  /// staff account (which locks this row), so Staff IDs are never repeated or reused.
  staffSequence    Int          @default(0)
  /// The last student number given in this branch (Student IDs, e.g. JHA-001-B001-S0001); raised only
  /// by the update that registers a student (which locks this row), so Student IDs are never reused.
  studentSequence  Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  locations                 BranchLocation[]
  managers                  User[]                     @relation("BranchManagers")
  managerAssignments        ManagerAssignment[]
  schedules                 BranchSchedule[]
  staffAssignments          StaffAssignment[]
  suspensionPeriods         SuspensionPeriod[]
  attendanceEvents          AttendanceEvent[]
  notifications             Notification[]
  reminderSettings          BranchReminderSettings?
  transfersOut              StaffTransfer[]            @relation("TransferFrom")
  transfersIn               StaffTransfer[]            @relation("TransferTo")
  sections                  Section[]
  students                  Student[]
  enrollments               Enrollment[]
  promotionBatches          PromotionBatch[]
  academicWeekdays          AcademicWeekdays[]
  calendarEntries           CalendarEntry[]
  teachingAssignments       TeachingAssignment[]
  bellSchedules             BellSchedule[]
  timetableVersions         TimetableVersion[]
  timetableSetups           TimetableSetup[]
  timetableDrafts           TimetableDraft[]
  studentAttendanceSettings StudentAttendanceSettings?
  studentAttendanceSessions StudentAttendanceSession[]
  studentExcuses            StudentExcuse[]

  @@unique([schoolId, number])
  @@unique([schoolId, code])
  @@unique([schoolId, nameKey])
  @@index([schoolId, status])
}

/// A branch GPS location and the time it takes effect. Each applies until the next one starts.
/// Never edited or deleted; a scheduled (future) location that was replaced or cancelled before it
/// took effect has cancelledAt set and never applies.
model BranchLocation {
  id               String            @id @default(uuid())
  branchId         String
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  latitude         Float
  longitude        Float
  /// Accuracy reported by the device when captured, in metres (at most 50).
  accuracyMeters   Float
  effectiveFrom    DateTime
  recordedAt       DateTime          @default(now())
  cancelledAt      DateTime?
  attendanceEvents AttendanceEvent[]

  @@index([branchId, effectiveFrom])
}

/// A Manager's assignment to a branch, from startedAt until endedAt (null: the current one). A
/// transfer ends the current assignment and starts a new one; rows are never edited otherwise or
/// deleted. At most one open assignment per Manager (partial unique index in the migration).
model ManagerAssignment {
  id        String    @id @default(uuid())
  managerId String
  manager   User      @relation(fields: [managerId], references: [id], onDelete: Restrict)
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([managerId, startedAt])
  @@index([branchId])
}

/// A version of a branch's schedule (Manager): applies from effectiveAt (00:00 of effectiveFrom in
/// timeZone, or a chosen time when Platform Settings allow timed changes) until the next version
/// starts. Never edited or deleted; a scheduled (future) version that was replaced or cancelled
/// before it started has cancelledAt set and never applies. One non-cancelled version per branch
/// and instant (partial unique index in the migration).
model BranchSchedule {
  id               String            @id @default(uuid())
  branchId         String
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  effectiveFrom    DateTime          @db.Date
  /// The instant it takes effect (its local date is effectiveFrom).
  effectiveAt      DateTime
  /// The platform time zone when the version was saved; its times are wall-clock times in this zone.
  timeZone         String
  checkOutEnabled  Boolean
  recordedAt       DateTime          @default(now())
  cancelledAt      DateTime?
  shifts           BranchShift[]
  attendanceEvents AttendanceEvent[]

  @@index([branchId, effectiveFrom])
  @@index([branchId, effectiveAt])
}

/// A shift of one schedule version. Same-day only: startMinute < endMinute, minutes after midnight
/// (0–1439). Shifts of a version that share a day do not overlap (checked by the API).
model BranchShift {
  id                   String         @id @default(uuid())
  scheduleId           String
  schedule             BranchSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  /// The shift's identity across schedule versions (kept when a change edits it; new for a new shift).
  shiftKey             String
  name                 String
  days                 Weekday[]
  startMinute          Int
  endMinute            Int
  /// A check-in after start + grace is late.
  graceMinutes         Int
  /// No check-in by start + cutoff (and no approved excuse) is absent.
  absenceCutoffMinutes Int

  @@unique([scheduleId, shiftKey])
  @@index([scheduleId])
}

/// A staff member's shift assignments from effectiveAt (00:00 of effectiveFrom in timeZone, or a
/// chosen time when Platform Settings allow timed changes) until the next set starts. Never edited
/// or deleted; a scheduled set that was replaced or cancelled has cancelledAt. One non-cancelled
/// set per staff member and instant (partial unique index in the migration).
model StaffAssignment {
  id               String                 @id @default(uuid())
  staffUserId      String
  staff            User                   @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  branchId         String
  branch           Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  effectiveFrom    DateTime               @db.Date
  /// The instant it takes effect (its local date is effectiveFrom).
  effectiveAt      DateTime
  timeZone         String
  recordedAt       DateTime               @default(now())
  cancelledAt      DateTime?
  shifts           StaffAssignmentShift[]
  attendanceEvents AttendanceEvent[]

  @@index([staffUserId, effectiveFrom])
  @@index([staffUserId, effectiveAt])
  @@index([branchId])
}

/// One assigned shift (by its shiftKey) and the days the staff member works it.
model StaffAssignmentShift {
  id           String          @id @default(uuid())
  assignmentId String
  assignment   StaffAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  shiftKey     String
  days         Weekday[]

  @@unique([assignmentId, shiftKey])
}

/// A suspension of a school or a branch (exactly one of them): from startedAt until endedAt (null
/// while it lasts). Written with each suspension and reactivation; never edited otherwise or
/// deleted. At most one open period per school and per branch (partial unique indexes).
model SuspensionPeriod {
  id          String    @id @default(uuid())
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  startedAt   DateTime
  endedAt     DateTime?
  reason      String
  /// Who suspended and who reactivated (account ids; names are in the audit log).
  startedById String?
  endedById   String?

  @@index([schoolId, startedAt])
  @@index([branchId, startedAt])
}

/// A recorded check-in or check-out (Staff mobile app). Never edited or deleted. occurredAt is the
/// event time claimed by the device, sentAt the device clock when it was sent, receivedAt the
/// server's time. A check-out points to the check-in it closes.
model AttendanceEvent {
  id             String              @id @default(uuid())
  staffUserId    String
  staff          User                @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type           AttendanceEventType
  /// The app's unique id for the event (idempotency key), unique per staff member.
  clientEventId  String
  occurredAt     DateTime
  sentAt         DateTime
  receivedAt     DateTime
  /// The branch-local day the event belongs to (the shift's day).
  workDate       DateTime            @db.Date
  shiftKey       String
  scheduleId     String
  schedule       BranchSchedule      @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  assignmentId   String
  assignment     StaffAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  locationId     String
  location       BranchLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  latitude       Float
  longitude      Float
  accuracyMeters Float
  distanceMeters Float
  /// CHECK_IN only: PRESENT or LATE.
  status         AttendanceStatus?
  /// CHECK_OUT only: the check-in it closes (one check-out per check-in).
  checkInEventId String?             @unique
  checkIn        AttendanceEvent?    @relation("CheckOut", fields: [checkInEventId], references: [id], onDelete: Restrict)
  checkOut       AttendanceEvent?    @relation("CheckOut")

  @@unique([staffUserId, clientEventId])
  @@index([staffUserId, workDate])
  @@index([branchId, workDate])
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id         String      @id @default(uuid())
  tokenHash  String      @unique
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime    @default(now())
  ipAddress  String?
  userAgent  String?
  pushDevice PushDevice?

  @@index([userId])
  @@index([expiresAt])
}

/// Record of an important platform action. Actor and target names are copied at the time of the
/// event so the history stays readable if records change later. Never store secrets here.
model AuditEvent {
  id          String      @id @default(uuid())
  occurredAt  DateTime    @default(now())
  /// e.g. SIGN_IN, SIGN_OUT (see backend/src/features/audit-logs/auditActions.js)
  action      String
  result      AuditResult
  actorId     String?
  actor       User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String?
  actorRole   Role?
  /// 'school' | 'owner' | 'branch' | 'manager' | 'system' | 'user'
  targetType  String
  targetId    String?
  targetName  String?
  schoolId    String?
  school      School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  description String
  /// { field, from, to } for status changes.
  change      Json?
  ipAddress   String?
  userAgent   String?

  @@index([occurredAt])
  @@index([action])
  @@index([actorId])
  @@index([schoolId])
}

/// Platform-wide settings: a single row (id = 'platform'). Only the fields whose meaning is clear
/// are stored. A Super Admin can change the platform name (Branding) and the session lifetime and
/// inactivity timeout (Authentication); the other fields are read-only.
model PlatformSettings {
  id                       String   @id @default("platform")
  platformName             String?
  description              String?
  supportEmail             String?
  supportPhone             String?
  websiteUrl               String?
  timezone                 String?
  language                 String?
  dateFormat               String?
  timeFormat               String?
  firstDayOfWeek           String?
  /// Absolute session lifetime in hours for new sign-ins (1–72). Null or invalid: SESSION_HOURS, then 12.
  sessionLifetimeHours     Int?
  /// Inactivity timeout in minutes for every session (5, 10, 15, 30, 60, 120, 240 or 480). Null or any other value: disabled.
  inactivityTimeoutMinutes Int?
  /// Scheduling & Assignments: the minimum effective delay in calendar days (1–30, platform time
  /// zone) for schedule changes, assignment changes and staff transfers. Null: 1 day.
  effectiveDelayDays       Int?
  /// Whether a branch's first schedule may start today. Null: yes. When false it waits for the delay.
  immediateFirstSchedule   Boolean?
  /// Whether a staff member's first assignment set may start today. Null: yes. When false it waits for the delay.
  immediateFirstAssignment Boolean?
  /// "Allow changes to take effect at their scheduled time": schedule changes, assignment changes
  /// and transfers may start today or later at a chosen time (not in the past), without the delay.
  /// Null: no (the effective delay applies; changes start at 00:00).
  timedChanges             Boolean?
  updatedAt                DateTime @updatedAt
}

// ---- Notifications (docs/notifications/) -------------------------------------------------------
// Personal notifications are stored once per recipient (read state per row); platform
// announcements are stored once with their audience and resolved when a user reads (N19).
// Business changes write a NotificationEvent (outbox) in their own transaction; notifications are
// created from it after the commit, so a failure there never undoes the change and a retry never
// duplicates (unique dedupe keys). Texts are rendered from `type` + `params` in the notification's
// language (Somali only today, N24).

/// Users may turn off the optional categories; STATUS, MANAGER_ASSIGNMENT and ANNOUNCEMENT are mandatory (N12).
enum NotificationCategory {
  ATTENDANCE // late check-ins (Managers)
  MISSING_CHECK_OUT // a check-out never recorded (staff)
  DIGEST // daily attendance digests (Managers, Owners)
  ASSIGNMENT // the staff member's shift assignments
  SCHEDULE // branch schedule changes affecting the staff member's shifts
  BRANCH_SETUP // a branch with no schedule or no active Manager
  MANAGER_ASSIGNMENT // the Manager's own transfer (mandatory)
  STATUS // school and branch suspension and reactivation (mandatory)
  ANNOUNCEMENT // platform announcements (mandatory)
  TRANSFER // a staff member's own branch transfer, and staff joining a Manager's branch (mandatory)
  STUDENT_ATTENDANCE // student attendance not taken (teachers, Managers) and daily summaries (Owners)
}

/// DRAFT (not visible), PUBLISHED (visible from publishAt until expiresAt; "scheduled" while
/// publishAt is in the future) and WITHDRAWN (never visible again).
enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum OutboxStatus {
  PENDING
  DONE
  FAILED
}

/// A push message (one user, all their devices): PENDING (queued, or waiting to be retried) →
/// SUBMITTED (Expo accepted it for at least one device: a ticket) → ACCEPTED (a receipt confirms the
/// push service — FCM or APNs — accepted it for at least one device). FAILED: no device could be
/// reached. SKIPPED: not sent on purpose (push turned off, account not active, notification expired
/// or withdrawn, no device). Neither state proves the phone displayed it.
enum PushStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  FAILED
  SKIPPED
}

/// One device's delivery of a push message. SUBMITTED: Expo returned a ticket. ACCEPTED: the receipt
/// is "ok" (handed to FCM/APNs). FAILED: refused (ticket or receipt error). UNCONFIRMED: no receipt
/// was available before it expired (24 hours).
enum PushDeliveryStatus {
  SUBMITTED
  ACCEPTED
  FAILED
  UNCONFIRMED
}

/// One notification for one recipient. Never edited except readAt; removed by the retention job
/// after expiresAt (90 days, N18). branchId is the branch it is about: a Manager sees it only while
/// assigned to that branch (N10); null = not tied to a branch (school notices, the transfer notice).
model Notification {
  id          String               @id @default(uuid())
  /// e.g. LATE_CHECK_IN (backend/src/features/notifications/notificationTypes.js)
  type        String
  category    NotificationCategory
  language    String               @default("so")
  recipientId String
  recipient   User                 @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  schoolId    String?
  school      School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// What it is about (e.g. 'attendanceEvent' + id), for links; never used for authorization.
  subjectType String?
  subjectId   String?
  /// Template values only (names, dates, times, counts). Never coordinates, secrets, or a suspension reason for anyone but the Owner.
  params      Json
  /// Unique per business event and recipient: processing the same event again creates nothing.
  dedupeKey   String               @unique
  createdAt   DateTime             @default(now())
  expiresAt   DateTime
  readAt      DateTime?

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([expiresAt])
}

/// Transactional outbox: written in the same transaction as the business change, turned into
/// notifications after the commit (and by the scheduled job when that failed), with retries.
model NotificationEvent {
  id            String       @id @default(uuid())
  type          String
  payload       Json
  dedupeKey     String       @unique
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
}

/// A platform announcement (Super Admin, N17), stored once with its audience (N19): users whose
/// role is in `roles` and whose school is targeted (all schools, or the listed ones).
model Announcement {
  id           String               @id @default(uuid())
  /// FEATURE | SEASONAL | GUIDE | UPDATE | MAINTENANCE
  kind         String
  title        String
  body         String
  language     String               @default("so")
  imageUrl     String?
  linkUrl      String?
  roles        Role[]
  allSchools   Boolean              @default(true)
  status       AnnouncementStatus   @default(DRAFT)
  publishAt    DateTime?
  expiresAt    DateTime
  publishedAt  DateTime?
  withdrawnAt  DateTime?
  /// Set when push messages for staff in the audience were queued (once it is visible).
  pushQueuedAt DateTime?
  createdById  String?
  updatedById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  schools      AnnouncementSchool[]
  reads        AnnouncementRead[]

  @@index([status, publishAt])
  @@index([expiresAt])
}

model AnnouncementSchool {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([announcementId, schoolId])
  @@index([schoolId])
}

/// Read state of an announcement per user (no row = unread).
model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
  @@index([userId])
}

/// Platform notification settings (single row, id = 'platform'; Super Admin, N5): reminder
/// defaults and limits, push on/off and the digest hour. Hard limits are database checks.
model NotificationSettings {
  id                      String   @id @default("platform")
  pushEnabled             Boolean  @default(true)
  checkInReminderEnabled  Boolean  @default(true)
  checkOutReminderEnabled Boolean  @default(true)
  uploadReminderEnabled   Boolean  @default(true)
  checkInLeadDefault      Int      @default(15)
  checkInLeadMin          Int      @default(0)
  checkInLeadMax          Int      @default(30)
  checkOutLeadDefault     Int      @default(10)
  checkOutLeadMin         Int      @default(0)
  checkOutLeadMax         Int      @default(60)
  staffCanAdjustTiming    Boolean  @default(true)
  /// Hour (platform time zone) from which the daily digest of the previous day is created.
  digestHour              Int      @default(6)
  updatedAt               DateTime @updatedAt
}

/// Branch reminder settings (the branch's Manager, within the platform limits). Null minutes = platform default.
model BranchReminderSettings {
  branchId                String   @id
  branch                  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  checkInReminderEnabled  Boolean  @default(true)
  checkOutReminderEnabled Boolean  @default(true)
  checkInLeadMinutes      Int?
  checkOutLeadMinutes     Int?
  updatedAt               DateTime @updatedAt
}

/// A user's own preferences (N12). Reminder fields apply to staff. Null minutes = branch or platform value.
model NotificationPreference {
  userId              String                 @id
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  disabledCategories  NotificationCategory[] @default([])
  pushEnabled         Boolean                @default(true)
  checkInReminder     Boolean                @default(true)
  checkOutReminder    Boolean                @default(true)
  uploadReminder      Boolean                @default(true)
  checkInLeadMinutes  Int?
  checkOutLeadMinutes Int?
  /// When the staff member agreed to background location for geofence reminders (N1); null = not agreed or withdrawn.
  locationConsentAt   DateTime?
  updatedAt           DateTime               @updatedAt
}

/// An Expo push token of a signed-in Staff app (N2 phase 3). Tied to the session: it is removed
/// when the session ends (sign-out, suspension, password reset, expiry cleanup).
model PushDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String   @unique
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// A push to send to one user (all their devices) for one notification or announcement. The
/// message shown is always generic (N21); the details stay in the app.
model PushMessage {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// notification:<id> | announcement:<id>
  sourceKey     String
  category      NotificationCategory
  status        PushStatus           @default(PENDING)
  attempts      Int                  @default(0)
  nextAttemptAt DateTime             @default(now())
  lastError     String?
  createdAt     DateTime             @default(now())
  /// When Expo first accepted it for a device (a ticket), and when a receipt first confirmed it.
  submittedAt   DateTime?
  acceptedAt    DateTime?
  deliveries    PushDelivery[]

  @@unique([userId, sourceKey])
  @@index([status, nextAttemptAt])
}

/// One device's attempt for a push message, with the Expo ticket and, later, its receipt. A token is
/// sent a message at most once (unique), so a retry reaches only the devices not yet reached.
model PushDelivery {
  id               String             @id @default(uuid())
  pushMessageId    String
  pushMessage      PushMessage        @relation(fields: [pushMessageId], references: [id], onDelete: Cascade)
  /// The device token at the time (the device row may be removed later).
  token            String
  platform         String
  status           PushDeliveryStatus
  /// Expo's ticket id (a receipt is looked up with it); null when refused at once.
  ticketId         String?
  /// Expo / provider error code (e.g. DeviceNotRegistered, MessageRateExceeded) and message.
  errorCode        String?
  errorMessage     String?
  submittedAt      DateTime           @default(now())
  receiptCheckedAt DateTime?

  @@unique([pushMessageId, token])
  @@index([status, submittedAt])
  @@index([ticketId])
}

// ---- Staff transfers between branches (docs/business-rules.md → Staff transfers) ------------

/// SCHEDULED until it takes effect (00:00 of effectiveFrom in its time zone), then COMPLETED (the
/// staff member's branch changes); CANCELLED before that by the School Owner. Never deleted.
enum StaffTransferStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// A staff member's move to another branch of the same school, decided by the School Owner. The
/// transfers are the staff member's branch history: the branch at any instant is the destination
/// of the latest transfer in effect by then (or the origin of the first later one), so attendance
/// events are always judged against the branch of their own time. At most one SCHEDULED transfer
/// per staff member (partial unique index).
model StaffTransfer {
  id            String              @id @default(uuid())
  staffUserId   String
  staff         User                @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  schoolId      String
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  fromBranchId  String
  fromBranch    Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranchId    String
  toBranch      Branch              @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  /// The branch-local date it takes effect, and that day's 00:00 as an instant (in timeZone).
  effectiveFrom DateTime            @db.Date
  effectiveAt   DateTime
  timeZone      String
  /// The destination shift assignment set created with the transfer (effective the same day).
  assignmentId  String?
  status        StaffTransferStatus @default(SCHEDULED)
  /// Who scheduled and who cancelled it (account ids; names are in the audit log).
  requestedById String?
  cancelledById String?
  createdAt     DateTime            @default(now())
  completedAt   DateTime?
  cancelledAt   DateTime?

  @@index([staffUserId, effectiveAt])
  @@index([status, effectiveAt])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([schoolId])
}

// ---- Data & Backup (docs/data-backup/) ------------------------------------------------------

/// Backups are Neon snapshots of this deployment's database branch; Neon is the source of truth for
/// which snapshots exist (they live outside this database, so a restore cannot erase the list).
/// These rows keep what Neon does not: who created a snapshot, its protection, its last check, and
/// its fate once Neon no longer lists it (expired or deleted).
model BackupRecord {
  /// The Neon snapshot id.
  snapshotId    String    @id
  name          String
  /// MANUAL (Create Backup Now) | SCHEDULED (Neon's schedule) | PRE_RESTORE
  kind          String
  /// Protected backups have no expiry and cannot be deleted until protection is removed.
  protected     Boolean   @default(false)
  expiresAt     DateTime?
  createdById   String?
  createdByName String?
  verifiedAt    DateTime?
  /// The last integrity check: { ok, checks: [...] }.
  verification  Json?
  deletedAt     DateTime?
  deletedByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum BackupOperationType {
  CREATE
  DELETE
  RESTORE
}

/// RUNNING → COMPLETED | FAILED. A restore is staged on a new branch (RUNNING), checked (VERIFIED),
/// then finalized into production (COMPLETED) or discarded (DISCARDED).
enum BackupOperationStatus {
  RUNNING
  VERIFIED
  COMPLETED
  FAILED
  DISCARDED
}

/// A backup or restore operation started from the Data & Backup page. At most one active operation
/// per lane ('backup', 'restore'): partial unique index on lane while RUNNING or VERIFIED.
model BackupOperation {
  id                   String                @id @default(uuid())
  type                 BackupOperationType
  status               BackupOperationStatus @default(RUNNING)
  lane                 String
  snapshotId           String?
  /// Restore: the staged branch (Neon id and name), never a connection string.
  branchId             String?
  branchName           String?
  providerOperationIds String[]              @default([])
  /// Verification results, the preserved pre-restore branch name, …
  result               Json?
  errorCode            String?
  errorMessage         String?
  requestedById        String?
  requestedByName      String?
  startedAt            DateTime              @default(now())
  finishedAt           DateTime?

  @@index([type, startedAt])
  @@index([snapshotId])
}

/// Data & Backup settings kept by EduTrack (the scheduled snapshot settings live in Neon).
model BackupSettings {
  id                  String   @id @default("platform")
  /// Days a manual backup is kept before Neon deletes it (unless protected).
  manualRetentionDays Int      @default(30)
  updatedById         String?
  updatedAt           DateTime @updatedAt
}

/// Academic year lifecycle (docs/business-rules.md → Academic years): PLANNED → CURRENT → CLOSED.
enum AcademicYearStatus {
  PLANNED
  CURRENT
  CLOSED
}

/// A school's academic year (School Owner manages; the school's Managers read). School level: it
/// applies to every branch of the school. At most one CURRENT year per school, and the date ranges
/// of one school's years never overlap (partial unique index and exclusion constraint in the
/// migration). A CLOSED year is read only; only a PLANNED year can be deleted.
model AcademicYear {
  id                        String                     @id @default(uuid())
  schoolId                  String
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// e.g. "2026/2027". At most 40 characters; unique in the school regardless of capitalization.
  name                      String
  /// The name compared for uniqueness (same folding as branch names; computed by the API).
  nameKey                   String
  /// Calendar dates (no time, no time zone). Both inclusive; endDate after startDate.
  startDate                 DateTime                   @db.Date
  endDate                   DateTime                   @db.Date
  status                    AcademicYearStatus         @default(PLANNED)
  /// Whether the school's Managers may set their own branch's school days for this year (School
  /// Owner). Turning it off returns every branch to the school's days from the next day.
  branchWeekdaysAllowed     Boolean                    @default(false)
  startedAt                 DateTime?
  closedAt                  DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  sections                  Section[]
  enrollments               Enrollment[]
  promotionsFrom            PromotionBatch[]           @relation("PromotionFrom")
  promotionsTo              PromotionBatch[]           @relation("PromotionTo")
  weekdays                  AcademicWeekdays[]
  calendarEntries           CalendarEntry[]
  teachingAssignments       TeachingAssignment[]
  timetableVersions         TimetableVersion[]
  timetableSetups           TimetableSetup[]
  teacherTimetableProfiles  TeacherTimetableProfile[]
  timetableDrafts           TimetableDraft[]
  studentAttendanceSessions StudentAttendanceSession[]

  @@unique([schoolId, nameKey])
  @@index([schoolId, startDate])
}

/// Class and section status: deactivated instead of deleted, so history keeps them.
enum ClassStatus {
  ACTIVE
  INACTIVE
}

/// A permanent class of a school (e.g. "Grade 7"), created once by the School Owner and reused
/// every academic year (docs/business-rules.md → Classes and sections). Never deleted.
model SchoolClass {
  id            String      @id @default(uuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// At most 60 characters; unique in the school regardless of capitalization.
  name          String
  /// The name compared for uniqueness (same folding as branch names; computed by the API).
  nameKey       String
  description   String?
  /// Academic progression order (1 = first class). Unique in the school.
  sequence      Int
  status        ClassStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sections Section[]
  subjects ClassSubject[]

  @@unique([schoolId, nameKey])
  @@unique([schoolId, sequence])
  @@index([schoolId, status])
}

/// A section of a class for one academic year in one branch (e.g. "Grade 7A" in 2026/2027 at Main
/// Branch). A new year gets new sections; old ones stay with their year. Never deleted.
model Section {
  id             String       @id @default(uuid())
  /// The school of the class, year and branch (checked by the API to be the same school).
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classId        String
  class          SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  /// e.g. "A". At most 20 characters; unique per class, year and branch regardless of capitalization.
  name           String
  nameKey        String
  capacity       Int?
  room           String?
  status         ClassStatus  @default(ACTIVE)
  deactivatedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  timetableVersions   TimetableVersion[]
  timetableFixedLessons TimetableFixedLesson[]
  timetableDraftLessons TimetableDraftLesson[]
  promotionsFrom      PromotionItem[]            @relation("PromotionItemFrom")
  promotionsTarget    PromotionItem[]            @relation("PromotionItemTarget")
  attendanceSessions  StudentAttendanceSession[]

  @@unique([classId, academicYearId, branchId, nameKey])
  @@index([schoolId, academicYearId])
  @@index([branchId, academicYearId])
}

/// Student profile status (docs/business-rules.md → Students).
enum StudentStatus {
  PENDING_ENROLLMENT
  ENROLLED
  TRANSFERRED_OUT
  GRADUATED
}

enum StudentGender {
  MALE
  FEMALE
}

/// A permanent student profile, registered once in a branch of a school and kept for good. Academic
/// years are linked through Enrollment; a profile can exist without one (PENDING_ENROLLMENT).
model Student {
  id                    String        @id @default(uuid())
  schoolId              String
  school                School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branchId              String
  branch                Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// Generated Student ID: branch code + "-S" + number (at least four digits). Unique; never changed or reused.
  studentNumber         String        @unique
  firstName             String
  middleName            String?
  lastName              String
  /// Full name compared for possible duplicates (folded like branch names; computed by the API).
  nameKey               String
  gender                StudentGender
  dateOfBirth           DateTime      @db.Date
  phone                 String?
  address               String?
  guardianName          String
  guardianPhone         String
  guardianRelationship  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  status                StudentStatus @default(PENDING_ENROLLMENT)
  /// Why the status last changed to TRANSFERRED_OUT or GRADUATED (kept in the audit log too).
  statusReason          String?
  statusChangedAt       DateTime?
  registeredAt          DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  enrollments       Enrollment[]
  promotionItems    PromotionItem[]
  attendanceEntries StudentAttendanceEntry[]
  excuses           StudentExcuse[]

  @@index([schoolId, branchId, status])
  @@index([schoolId, nameKey, dateOfBirth])
}

/// ACTIVE: in progress. COMPLETED: the year ended and the student continued (promoted or repeating, in
/// a later enrollment). TRANSFERRED_OUT / GRADUATED: the last enrollment of a student who left or finished.
enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED_OUT
  GRADUATED
}

/// How a student came into an enrollment: newly enrolled, promoted, or repeating a class.
enum EnrollmentEntry {
  NEW
  PROMOTED
  REPEATED
}

/// The year-end result the Manager records; it drives promotion recommendations.
enum EnrollmentResult {
  PASSED
  FAILED
}

/// A student in a section for one academic year. One per student and year; never deleted, never moved
/// to another year. The class is the section's class (not stored twice).
model Enrollment {
  id                   String            @id @default(uuid())
  schoolId             String
  school               School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branchId             String
  branch               Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  studentId            String
  student              Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYearId       String
  academicYear         AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sectionId            String
  section              Section           @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  status               EnrollmentStatus  @default(ACTIVE)
  entry                EnrollmentEntry   @default(NEW)
  result               EnrollmentResult?
  /// The previous-year enrollment this one continues (promotion or repeating).
  previousEnrollmentId String?           @unique
  previousEnrollment   Enrollment?       @relation("EnrollmentHistory", fields: [previousEnrollmentId], references: [id], onDelete: Restrict)
  nextEnrollment       Enrollment?       @relation("EnrollmentHistory")
  enrolledAt           DateTime          @default(now())
  endedAt              DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  promotionItemsFrom   PromotionItem[]          @relation("PromotionItemFromEnrollment")
  promotionItemsResult PromotionItem[]          @relation("PromotionItemResultEnrollment")
  attendanceEntries    StudentAttendanceEntry[]

  @@unique([studentId, academicYearId])
  @@index([sectionId, status])
  @@index([branchId, academicYearId, status])
}

enum PromotionBatchStatus {
  DRAFT
  PROCESSING
  COMPLETED
}

enum PromotionDecision {
  PROMOTE
  REPEAT
  TRANSFER_OUT
  GRADUATE
  PENDING
}

/// DRAFT: before confirmation. WAITING: confirmed, not processed yet. DONE / FAILED: processed (a
/// failed one can be retried). EXCLUDED: left PENDING (for review) at confirmation, so nothing was done.
enum PromotionItemStatus {
  DRAFT
  WAITING
  DONE
  FAILED
  EXCLUDED
}

/// Bulk Academic Year Enrollment & Promotion for one branch, from one academic year to the next. One
/// per branch and pair of years, so a retry resumes it instead of starting another.
model PromotionBatch {
  id              String               @id @default(uuid())
  schoolId        String
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branchId        String
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  fromYearId      String
  fromYear        AcademicYear         @relation("PromotionFrom", fields: [fromYearId], references: [id], onDelete: Restrict)
  toYearId        String
  toYear          AcademicYear         @relation("PromotionTo", fields: [toYearId], references: [id], onDelete: Restrict)
  status          PromotionBatchStatus @default(DRAFT)
  createdById     String
  createdByName   String
  confirmedById   String?
  confirmedByName String?
  confirmedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  items PromotionItem[]

  @@unique([branchId, fromYearId, toYearId])
  @@index([schoolId])
}

/// One student's decision in a promotion batch: what was recommended and why, what the Manager chose,
/// where the student goes, and what happened when it was processed (the new enrollment, or the error).
model PromotionItem {
  id                 String              @id @default(uuid())
  batchId            String
  batch              PromotionBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  studentId          String
  student            Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  fromEnrollmentId   String
  fromEnrollment     Enrollment          @relation("PromotionItemFromEnrollment", fields: [fromEnrollmentId], references: [id], onDelete: Restrict)
  fromSectionId      String
  fromSection        Section             @relation("PromotionItemFrom", fields: [fromSectionId], references: [id], onDelete: Restrict)
  recommendation     PromotionDecision
  /// Why it was recommended, e.g. "Passed", "No result recorded", "Final class".
  recommendationNote String
  decision           PromotionDecision
  targetSectionId    String?
  targetSection      Section?            @relation("PromotionItemTarget", fields: [targetSectionId], references: [id], onDelete: Restrict)
  status             PromotionItemStatus @default(DRAFT)
  error              String?
  attempts           Int                 @default(0)
  resultEnrollmentId String?
  resultEnrollment   Enrollment?         @relation("PromotionItemResultEnrollment", fields: [resultEnrollmentId], references: [id], onDelete: Restrict)
  processedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([batchId, fromEnrollmentId])
  @@index([batchId, status])
}

// ---- Academic calendar (docs/business-rules.md → Academic calendar) ---------------------------
// When students have school: the weekly school days of an academic year (school default, optional
// branch override) and the calendar's exceptions (school holidays, branch closures, branch
// reopenings of a holiday). Independent of staff schedules (BranchSchedule / BranchShift), which
// say when staff work. Suspensions stay in SuspensionPeriod. Dates are calendar dates in the
// platform time zone. Rows are never deleted: changes that never took effect are cancelled.

/// The weekly school days of one academic year, for the whole school (branchId null; School Owner)
/// or one branch (its Manager, while the year allows branch school days). Versioned like
/// BranchSchedule: a version applies from effectiveFrom until the next one of the same level; it is
/// never edited; a version that had not started yet can be cancelled (cancelledAt). A branch
/// version with followsSchool returns the branch to the school's days from its date. At most one
/// non-cancelled version per level and date (partial unique indexes in the migration).
model AcademicWeekdays {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  /// Null: the school's default days. Set: that branch's own days (a branch of the same school).
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// MON…SUN, at least one (empty only for a followsSchool version; database check).
  days           Weekday[]
  followsSchool  Boolean      @default(false)
  effectiveFrom  DateTime     @db.Date
  recordedAt     DateTime     @default(now())
  cancelledAt    DateTime?

  @@index([academicYearId, branchId, effectiveFrom])
  @@index([schoolId])
}

enum CalendarEntryType {
  /// School-wide day(s) without school (School Owner).
  HOLIDAY
  /// One branch closed (its Manager, or the School Owner).
  CLOSURE
  /// One branch has school during part of a school holiday that allows it (its Manager, or the School Owner).
  REOPENING
  /// Extra school day(s) following one weekday's timetable (timetableDay): a make-up day on a day
  /// without school, or a timetable swap on a school day. School level (School Owner) or one branch
  /// (its Manager, or the School Owner). Closures and holidays still win.
  SCHOOL_DAY
}

/// An exception in the academic calendar, from startDate to endDate (both inclusive), inside one
/// academic year of the school. HOLIDAY: school level (no branch). CLOSURE and REOPENING: one branch;
/// a REOPENING belongs to the HOLIDAY it reopens and lies within it. Days before today are fixed: an
/// entry that had not started can be cancelled (cancelledAt), a running one only ends early. Active
/// entries of one type never overlap at the same level (exclusion constraints in the migration).
model CalendarEntry {
  id                   String            @id @default(uuid())
  schoolId             String
  school               School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId       String
  academicYear         AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  branchId             String?
  branch               Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type                 CalendarEntryType
  /// e.g. "Eid al-Fitr", "Closed: road flooding". 2–80 characters.
  name                 String
  /// Optional details, at most 300 characters.
  note                 String?
  startDate            DateTime          @db.Date
  endDate              DateTime          @db.Date
  /// HOLIDAY only: whether the school's Managers may reopen it for their branch.
  allowBranchReopening Boolean           @default(false)
  /// SCHOOL_DAY only: the weekday whose timetable and bell times the day follows.
  timetableDay         Weekday?
  /// REOPENING only: the holiday it reopens.
  holidayId            String?
  holiday              CalendarEntry?    @relation("HolidayReopenings", fields: [holidayId], references: [id], onDelete: Restrict)
  reopenings           CalendarEntry[]   @relation("HolidayReopenings")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  cancelledAt          DateTime?

  @@index([schoolId, academicYearId, startDate])
  @@index([branchId, startDate])
  @@index([holidayId])
}

// ---- Subjects and teaching (docs/business-rules.md → Subjects; Teaching assignments) ------------
// What is taught and who teaches it. A staff member keeps their one home branch (User.branchId:
// Staff ID, check-in, shifts, transfers); teaching assignments say which sections of their school
// (any branch) they teach. Teaching permissions come from these assignments, never from the job title.

/// A subject of a school (e.g. "Mathematics"), created once by the School Owner and used every year.
/// Never deleted: deactivated instead (ClassStatus).
model Subject {
  id            String      @id @default(uuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// At most 60 characters; unique in the school regardless of capitalization.
  name          String
  nameKey       String
  /// Optional short code (e.g. "MATH"), at most 12 characters, unique in the school when given.
  code          String?
  description   String?
  status        ClassStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  classes             ClassSubject[]
  teachingAssignments TeachingAssignment[]
  timetableSlots      TimetableSlot[]
  timetableFixedLessons TimetableFixedLesson[]
  timetableDraftLessons TimetableDraftLesson[]
  attendanceSessions  StudentAttendanceSession[]

  @@unique([schoolId, nameKey])
  @@index([schoolId, status])
}

/// A class's curriculum (School Owner): the subjects a class studies, with an optional number of
/// lessons per week (used by timetables). Applies every year. A class without any is open to every
/// active subject of the school.
model ClassSubject {
  id            String      @id @default(uuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classId       String
  class         SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// Lessons per week (1–40), or null when not planned.
  weeklyLessons Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
}

enum TeachingRole {
  /// Teaches one subject to a section: may take that subject's lesson attendance.
  SUBJECT_TEACHER
  /// Responsible for a section as a whole (homeroom). Does not by itself allow taking any lesson's attendance.
  CLASS_TEACHER
}

/// A staff member's teaching in one section of one academic year, from startDate to endDate (both
/// inclusive; endDate null: until the year ends). SUBJECT_TEACHER names a subject; CLASS_TEACHER does
/// not. The section may be in any branch of the teacher's school. Never deleted: one that has not
/// started can be cancelled (cancelledAt), a running one ends early. The database keeps one active
/// class teacher per section at a time, and never the same teacher twice for a section's subject at
/// once (exclusion constraints in the migration).
model TeachingAssignment {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  /// The section's branch (stored for scoping: a Manager sees their branch's).
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  teacherId      String
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  role           TeachingRole
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  startDate      DateTime     @db.Date
  endDate        DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cancelledAt    DateTime?

  @@index([sectionId, role])
  @@index([teacherId, academicYearId])
  @@index([schoolId, academicYearId, branchId])
  @@index([subjectId])
}

// ---- Bell schedules and timetables (docs/business-rules.md → Bell schedules; Timetables) --------
// When lessons happen. A bell schedule gives the times of a school day's lessons (numbered periods)
// and breaks; one break may be the main break that splits the day into two halves (Manager
// attendance before and after the break). A section's timetable names its bell schedule and which
// subject (and teacher) each period of each weekday has. Both are versioned by date like the
// school days: never edited, never deleted; a version that had not started can be cancelled.
// Whether there is school on a date is still decided only by the academic calendar.

/// A named bell schedule (e.g. "Morning", "Afternoon"), for the whole school (branchId null; School
/// Owner) or one branch (its Manager, or the School Owner). Not tied to an academic year: its
/// versions say from when each set of times applies. Never deleted: deactivated instead.
model BellSchedule {
  id            String      @id @default(uuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branchId      String?
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// At most 60 characters; unique per level (the school's, each branch's) regardless of capitalization.
  name          String
  nameKey       String
  description   String?
  status        ClassStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  versions   BellScheduleVersion[]
  timetables TimetableVersion[]
  setupDefaults TimetableSetup[]

  @@index([schoolId, status])
  @@index([branchId])
}

/// The times of a bell schedule from effectiveFrom until its next version. At most one non-cancelled
/// version per schedule and date (partial unique index in the migration).
model BellScheduleVersion {
  id             String       @id @default(uuid())
  bellScheduleId String
  bellSchedule   BellSchedule @relation(fields: [bellScheduleId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime     @db.Date
  recordedAt     DateTime     @default(now())
  cancelledAt    DateTime?
  periods        BellPeriod[]

  @@index([bellScheduleId, effectiveFrom])
}

enum BellPeriodKind {
  /// A numbered lesson period (1, 2, …) that timetables fill.
  LESSON
  BREAK
}

/// One lesson period or break of a bell schedule version on the given weekdays, from startMinute to
/// endMinute (minutes after midnight, same day). On each weekday the version's periods do not
/// overlap, lesson numbers are unique and follow the time order, and at most one break is the main
/// break, with lessons before and after it (checked by the API).
model BellPeriod {
  id          String              @id @default(uuid())
  versionId   String
  version     BellScheduleVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  kind        BellPeriodKind
  /// LESSON: 1–20. BREAK: null.
  number      Int?
  /// Optional label, e.g. "Break", "Lunch".
  name        String?
  days        Weekday[]
  startMinute Int
  endMinute   Int
  /// BREAK only: splits the day into the half before and the half after it.
  mainBreak   Boolean             @default(false)

  @@index([versionId])
}

/// A section's timetable from effectiveFrom until its next version: its bell schedule and its
/// lessons. A version without lessons still gives the section its bell schedule. At most one
/// non-cancelled version per section and date (partial unique index in the migration).
model TimetableVersion {
  id             String          @id @default(uuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  /// The section's branch (stored for scoping).
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sectionId      String
  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  bellScheduleId String
  bellSchedule   BellSchedule    @relation(fields: [bellScheduleId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime        @db.Date
  recordedAt     DateTime        @default(now())
  cancelledAt    DateTime?
  slots          TimetableSlot[]

  @@index([sectionId, effectiveFrom])
  @@index([schoolId, academicYearId, branchId])
  @@index([bellScheduleId])
}

/// One lesson of a timetable version: a weekday's numbered period, its subject and, optionally, the
/// teacher who takes it (null: any of the section's teachers of that subject). One lesson per period.
model TimetableSlot {
  id           String           @id @default(uuid())
  versionId    String
  version      TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  weekday      Weekday
  periodNumber Int
  subjectId    String
  subject      Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId    String?
  teacher      User?            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  /// Optional room for this lesson (otherwise the section's room), at most 40 characters.
  room         String?

  @@unique([versionId, weekday, periodNumber])
  @@index([teacherId])
  @@index([subjectId])
}

// ---- Student attendance (docs/business-rules.md → Student attendance) ----------------------------
// Switched on per school by the Super Admin (School.studentAttendanceEnabled). A Manager takes
// attendance of each section once or twice a school day (before and after the main break); teachers
// take lesson attendance (Phase 5). Each session keeps the class list it had when it was opened (its
// entries), each entry the current mark, and every mark and change is kept in the change history.
// Nothing here is ever deleted. Excuses are kept apart and applied when attendance is read.

/// How often a Manager takes a section's attendance on a school day.
enum AttendanceFrequency {
  /// Once: one session for the whole day.
  ONCE_DAILY
  /// Twice: before and after the main break (one session on days without a main break).
  TWICE_DAILY
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  /// Managers only, with a reason.
  EXCUSED
}

enum AttendanceSessionKind {
  /// A Manager's session for a half of the day (or the whole day).
  HALF_DAY
  /// A teacher's lesson (Phase 5).
  LESSON
}

enum DayHalf {
  WHOLE_DAY
  BEFORE_BREAK
  AFTER_BREAK
}

enum AttendanceMarkSource {
  WEB
  MOBILE
}

/// Student attendance settings: the school's defaults (branchId null; School Owner) and a branch's
/// own values (its Manager, only for the settings the school lets branches change). Null: not set
/// here (the branch follows the school, the school the platform default). Read only through
/// backend/src/features/student-attendance/settings.js (effective settings). Limits are database checks.
model StudentAttendanceSettings {
  id                          String               @id @default(uuid())
  schoolId                    String
  school                      School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// Null: the school's defaults (one per school). Set: that branch's own values (one per branch).
  branchId                    String?              @unique
  branch                      Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  halfDayFrequency            AttendanceFrequency?
  /// Minutes before a half starts that its attendance can be taken (0–240).
  halfDayOpensBeforeMinutes   Int?
  /// Minutes after a half ends until its attendance is due (0–1440). Later marks count as late entries.
  halfDayDeadlineAfterMinutes Int?
  /// Days after a date that a Manager can still take or correct its attendance (0–90).
  managerEditDays             Int?
  /// Whether changing a mark after the deadline needs a reason.
  correctionReasonRequired    Boolean?
  /// Teacher lesson attendance (Phase 5): window before a lesson starts (0–60) and after it ends (0–720).
  lessonOpensBeforeMinutes    Int?
  lessonDeadlineAfterMinutes  Int?
  /// Teacher lesson attendance (Phase 5): minutes after marking that a teacher may correct their own marks (0–1440).
  teacherCorrectionMinutes    Int?
  /// Offline marks recorded inside the window may be uploaded this many minutes after the deadline (0–4320).
  offlineGraceMinutes         Int?
  /// Notifications: remind teachers of lessons whose attendance was not taken by the deadline.
  teacherReminders            Boolean?
  /// Notifications: tell the branch's Managers when a day's attendance is incomplete.
  managerAlerts               Boolean?
  /// School row only: the settings the school's Managers may change for their branch.
  branchOverridable           String[]             @default([])
  updatedById                 String?
  updatedByName               String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@index([schoolId])
}

/// One attendance session of a section on a date: a Manager's half of the day (HALF_DAY), or a
/// teacher's lesson (LESSON, Phase 5). Created when it is opened, with the class list of that moment
/// (entries) and its times and deadline fixed then (later settings or bell time changes do not move
/// them). At most one HALF_DAY session per section, date and half, and never a whole-day session
/// beside half-day ones (database constraints).
model StudentAttendanceSession {
  id             String                    @id @default(uuid())
  schoolId       String
  school         School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branchId       String
  branch         Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sectionId      String
  section        Section                   @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  kind           AttendanceSessionKind     @default(HALF_DAY)
  date           DateTime                  @db.Date
  /// HALF_DAY: the half the session covers. LESSON: the half of the day the lesson is in (null: no main break).
  half           DayHalf?
  /// LESSON only: the timetable period and its subject.
  periodNumber   Int?
  subjectId      String?
  subject        Subject?                  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// The weekday whose timetable and bell times the day followed.
  timetableDay   Weekday?
  /// The half's times; null when the section had no bell times that day.
  startsAt       DateTime?
  endsAt         DateTime?
  /// From when marks can be taken, and when they are due.
  opensAt        DateTime
  deadlineAt     DateTime
  openedAt       DateTime                  @default(now())
  openedById     String?
  openedByName   String
  entries        StudentAttendanceEntry[]
  changes        StudentAttendanceChange[]

  @@index([branchId, date])
  @@index([sectionId, date])
  @@index([schoolId, date])
}

/// A student on a session's class list and their current mark (status null: not marked yet). The
/// list is fixed when the session opens; students enrolled later can be added. Every mark and change
/// is also kept in StudentAttendanceChange. `version` rises with each change (stale edits are refused).
model StudentAttendanceEntry {
  id           String                    @id @default(uuid())
  sessionId    String
  session      StudentAttendanceSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  schoolId     String
  branchId     String
  studentId    String
  student      Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollmentId String
  enrollment   Enrollment                @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  /// Added to the list after the session opened.
  addedLate    Boolean                   @default(false)
  addedAt      DateTime                  @default(now())
  status       StudentAttendanceStatus?
  /// Required for EXCUSED (and for corrections after the deadline when the school requires it).
  reason       String?
  note         String?
  markedAt     DateTime?
  markedById   String?
  markedByName String?
  /// The role of who set the current mark (a teacher cannot change a Manager's).
  markedByRole Role?
  /// When the mark was taken (on the device for offline marks); syncedAt when it reached the server.
  occurredAt   DateTime?
  syncedAt     DateTime?
  source       AttendanceMarkSource?
  version      Int                       @default(0)
  changes      StudentAttendanceChange[]

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([enrollmentId])
}

/// Every mark and change of a student's attendance in a session: from what to what, by whom, when
/// and why. Never edited or deleted.
model StudentAttendanceChange {
  id            String                   @id @default(uuid())
  entryId       String
  entry         StudentAttendanceEntry   @relation(fields: [entryId], references: [id], onDelete: Restrict)
  sessionId     String
  session       StudentAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  studentId     String
  fromStatus    StudentAttendanceStatus?
  toStatus      StudentAttendanceStatus
  reason        String?
  note          String?
  actorId       String?
  actorName     String
  actorRole     Role
  source        AttendanceMarkSource
  occurredAt    DateTime
  recordedAt    DateTime                 @default(now())
  /// Recorded after the session's deadline.
  afterDeadline Boolean                  @default(false)

  @@index([sessionId, recordedAt])
  @@index([entryId])
}

/// A student's excuse (Manager), from startDate to endDate (both inclusive): whole days, one half of
/// each day (half), or some lessons of each day (periods, Phase 5). Kept apart from the marks and
/// applied when attendance is read: an absent or unmarked student counts as excused. Never deleted:
/// cancelled instead.
model StudentExcuse {
  id              String    @id @default(uuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  startDate       DateTime  @db.Date
  endDate         DateTime  @db.Date
  /// Null: whole days (unless periods are given). BEFORE_BREAK / AFTER_BREAK: that half of each day.
  half            DayHalf?
  /// Lesson periods of each day (1–20); empty: not limited to lessons.
  periods         Int[]     @default([])
  reason          String
  note            String?
  createdById     String?
  createdByName   String
  createdAt       DateTime  @default(now())
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledByName String?

  @@index([studentId, startDate])
  @@index([branchId, startDate])
  @@index([schoolId])
}

// ---- Timetable builder (docs/business-rules.md → Timetable builder) ------------------------------
// Generated timetables are drafts until published; publishing writes ordinary TimetableVersion rows
// (one per section, through the same checks as the timetable editor), so everything that reads
// timetables (lessons of a day, student attendance, views) has one source.

enum TimetableDraftStatus {
  DRAFT
  PUBLISHED
  DISCARDED
}

/// The builder setup of one branch for one academic year: generation rules and each section's bell
/// schedule. Limits are checked in the migration.
model TimetableSetup {
  id                    String        @id @default(uuid())
  schoolId              String
  school                School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId        String
  academicYear          AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  branchId              String
  branch                Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// Used for sections without their own choice (and without a timetable to take it from).
  defaultBellScheduleId String?
  defaultBellSchedule   BellSchedule? @relation(fields: [defaultBellScheduleId], references: [id], onDelete: Restrict)
  /// { sectionId: bellScheduleId } for sections with their own bell schedule.
  sectionBells          Json          @default("{}")
  /// Sections left out of generation (their timetables are not changed).
  excludedSectionIds    String[]      @default([])
  /// Every lesson period of a class has a lesson: lessons a week must equal the lesson periods, and
  /// a draft with an empty period cannot be published. Off: classes may have free periods (at the end of the day).
  fillAllPeriods        Boolean       @default(true)
  /// Most lessons of one subject in one section on one day (1–6).
  maxSubjectPerDay      Int           @default(2)
  /// Two lessons of a subject may follow each other (a double lesson).
  allowDoubleLessons    Boolean       @default(true)
  /// Spread each subject's lessons over the week.
  spreadSubjects        Boolean       @default(true)
  /// Keep teachers' free periods between lessons few.
  avoidTeacherGaps      Boolean       @default(true)
  /// Most lessons a teacher teaches on one day (all branches); null: no limit. A teacher's own limit wins.
  teacherMaxPerDay      Int?
  /// Subjects preferred before the main break (or early in the day).
  morningSubjectIds     String[]      @default([])
  /// How long the generator searches for a better timetable (5–60 seconds).
  searchSeconds         Int           @default(10)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  fixedLessons TimetableFixedLesson[]
  drafts       TimetableDraft[]

  @@unique([branchId, academicYearId])
  @@index([schoolId])
  @@index([defaultBellScheduleId])
}

/// A teacher's limits and unavailable times for one academic year (every branch they teach in).
model TeacherTimetableProfile {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  teacherId      String
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  /// Most lessons on one day; null: the setup's limit.
  maxPerDay      Int?
  /// Most lessons in a week; null: no limit.
  maxPerWeek     Int?
  /// [{ weekday, startMinute, endMinute }]: times they cannot teach (clock times, any bell schedule).
  unavailable    Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([teacherId, academicYearId])
  @@index([schoolId, academicYearId])
}

/// A lesson the generator must place exactly here (and never move).
model TimetableFixedLesson {
  id           String         @id @default(uuid())
  setupId      String
  setup        TimetableSetup @relation(fields: [setupId], references: [id], onDelete: Restrict)
  sectionId    String
  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  weekday      Weekday
  periodNumber Int
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// Null: the section's teacher of the subject (decided when generating).
  teacherId    String?
  teacher      User?          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())

  @@unique([setupId, sectionId, weekday, periodNumber])
  @@index([sectionId])
  @@index([subjectId])
  @@index([teacherId])
}

/// A generated timetable of a branch, reviewed and edited before it is published. At most one DRAFT
/// per branch and year (partial unique index in the migration).
model TimetableDraft {
  id             String               @id @default(uuid())
  schoolId       String
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  branchId       String
  branch         Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  setupId        String
  setup          TimetableSetup       @relation(fields: [setupId], references: [id], onDelete: Restrict)
  status         TimetableDraftStatus @default(DRAFT)
  /// The date whose bell times, teaching assignments and other timetables it was planned for.
  planDate       DateTime             @db.Date
  /// [{ sectionId, bellScheduleId }]: the sections it covers.
  sections       Json
  seed           Int
  /// Increases with every change (stale edits are refused).
  revision       Int                  @default(1)
  /// { score, unplaced: [...], stats } of the last generation or edit.
  report         Json
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  publishedAt    DateTime?
  publishedById  String?
  publishedFrom  DateTime?            @db.Date
  discardedAt    DateTime?

  lessons TimetableDraftLesson[]

  @@index([schoolId, academicYearId, branchId])
  @@index([setupId])
}

model TimetableDraftLesson {
  id           String         @id @default(uuid())
  draftId      String
  draft        TimetableDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  sectionId    String
  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  weekday      Weekday
  periodNumber Int
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId    String?
  teacher      User?          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  /// Kept in place when generating again (fixed lessons are always locked).
  locked       Boolean        @default(false)
  fixed        Boolean        @default(false)

  @@unique([draftId, sectionId, weekday, periodNumber])
  @@index([draftId, teacherId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([teacherId])
}
