# Copy to backend/.env (production branch) and fill in real values. Never commit real secrets.
# For development, backend/.env.dev holds the same keys for the Neon "dev" branch
# (npm run dev / npm test load it first).

# Neon PostgreSQL — pooled connection string (runtime, used by the API)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

# Neon PostgreSQL — direct (non-pooled) connection string (Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

NODE_ENV="development"
PORT=4000

# Origin of the web app. Sign-in and other state-changing requests from any other origin are refused.
WEB_ORIGIN="http://localhost:5173"

# Fallback session lifetime in hours (1–72), used only while Platform Settings → Authentication has
# no value. Approved default: 12. Out-of-range or non-whole values are ignored (12 is used).
SESSION_HOURS=12

# backend/.env.dev only (Neon dev branch):
# EDUTRACK_DB_BRANCH="dev"            allows scripts/seed-dev.js to run
# DEV_ADMIN_PASSWORD="..."            sign-in for the seeded dev Super Admin (admin@edutrack.example)

# Notifications (docs/notifications/notification-architecture.md)
# Secret for the scheduled notification job (GET /api/internal/jobs/notifications). Vercel Cron sends
# it as "Authorization: Bearer <CRON_SECRET>" when this variable is set in the Vercel project. Without
# it the job endpoint is disabled (digests, missing check-outs, scheduled announcement pushes,
# retries and retention do not run). Use a long random value.
CRON_SECRET=""
# Optional: how long one job run may work (ms) before it leaves the rest for the next run.
# NOTIFICATION_JOB_BUDGET_MS=45000
# Optional: Expo push access token (only when "Enhanced push security" is on for the Expo project).
# EXPO_ACCESS_TOKEN=""
