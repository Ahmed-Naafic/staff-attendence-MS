# Copy to backend/.env (production branch) and fill in real values. Never commit real secrets.
# For development, backend/.env.dev holds the same keys for the Neon "dev" branch
# (npm run dev / npm test load it first).

# Neon PostgreSQL — pooled connection string (runtime, used by the API)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

# Neon PostgreSQL — direct (non-pooled) connection string (Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

NODE_ENV="development"
PORT=4000

# Origin of the web app. Sign-in and other state-changing requests from any other origin are refused.
WEB_ORIGIN="http://localhost:5173"

# Fallback session lifetime in hours (1–72), used only while Platform Settings → Authentication has
# no value. Approved default: 12. Out-of-range or non-whole values are ignored (12 is used).
SESSION_HOURS=12

# backend/.env.dev only (Neon dev branch). These sign-ins work on the dev branch only, never in production.
# Fill the dev branch (sample schools, these accounts, and a demo school "Aflax" with data in every
# table): npm run seed:dev --workspace backend. Reset only the passwords: npm run seed:dev-accounts.
# EDUTRACK_DB_BRANCH="dev"                          allows the dev seed scripts to run
# DEV_ADMIN_PASSWORD="-OaVgMRjO0UKoefykgOEI4ho"     Super Admin: admin@edutrack.example
# DEV_OWNER_PASSWORD="dev-owner-EhpX5aLlX5Ho"       Owner:       owner@edutrack.example
# DEV_MANAGER_PASSWORD="dev-manager-ifRuCFVQCQoq"   Manager:     manager@edutrack.example
# DEV_STAFF_PASSWORD="dev-staff-v9PM5v592_xc"       Teacher:     phone +252 61 7000001 (Staff mobile app)

# Sample data (Manager → Staff → Add Sample Staff: 20 sample staff, 15 teachers). Allowed on the Neon
# dev branch (EDUTRACK_DB_BRANCH="dev") without this; elsewhere only with SAMPLE_DATA="on". Leave it
# unset in production.
# SAMPLE_DATA="on"

# Notifications (docs/notifications/notification-architecture.md)
# Secret for the scheduled notification job (GET /api/internal/jobs/notifications). Vercel Cron sends
# it as "Authorization: Bearer <CRON_SECRET>" when this variable is set in the Vercel project. Without
# it the job endpoint is disabled (digests, missing check-outs, scheduled announcement pushes,
# retries and retention do not run). Use a long random value.
CRON_SECRET=""
# Optional: how long one job run may work (ms) before it leaves the rest for the next run.
# NOTIFICATION_JOB_BUDGET_MS=45000
# Optional: Expo push access token (only when "Enhanced push security" is on for the Expo project).
# EXPO_ACCESS_TOKEN=""
# Optional: Expo endpoints (the defaults are correct; tests point them at a local stub).
# EXPO_PUSH_URL="https://exp.host/--/api/v2/push/send"
# EXPO_RECEIPTS_URL="https://exp.host/--/api/v2/push/getReceipts"
# Android push also needs Firebase's google-services.json as the EAS file variable GOOGLE_SERVICES_JSON
# (apps/mobile, not this file); see docs/notifications/push-setup.md.

# Data & Backup (Platform Settings → Data & Backup; docs/data-backup/environment-configuration.md).
# Backups are Neon snapshots of NEON_BRANCH_ID (production's branch in Vercel, the dev branch in
# backend/.env.dev). The key can manage the whole Neon project: server only, never in Git or the web app.
# NEON_API_KEY=""
# NEON_PROJECT_ID=""
# NEON_BRANCH_ID=""
# Optional: NEON_DATABASE_NAME="neondb", NEON_ROLE_NAME (default: DIRECT_URL's user), NEON_API_URL.
