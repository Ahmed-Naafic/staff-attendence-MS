# Copy to backend/.env and fill in real values. Never commit real secrets.

# Neon PostgreSQL — pooled connection string (runtime, used by the API)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon PostgreSQL — direct (non-pooled) connection string (Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

NODE_ENV="development"
PORT=4000

# Long random string used to sign auth tokens
JWT_SECRET="replace-with-a-long-random-secret"
