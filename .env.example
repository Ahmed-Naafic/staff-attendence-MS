# Copy to backend/.env (production branch) and fill in real values. Never commit real secrets.
# For development, backend/.env.dev holds the same keys for the Neon "dev" branch
# (npm run dev / npm test load it first).

# Neon PostgreSQL — pooled connection string (runtime, used by the API)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

# Neon PostgreSQL — direct (non-pooled) connection string (Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

NODE_ENV="development"
PORT=4000

# Origin of the web app. Sign-in and other state-changing requests from any other origin are refused.
WEB_ORIGIN="http://localhost:5173"

# How long a sign-in lasts, in hours (technical default; not an approved business rule).
SESSION_HOURS=12

# backend/.env.dev only (Neon dev branch):
# EDUTRACK_DB_BRANCH="dev"            allows scripts/seed-dev.js to run
# DEV_ADMIN_PASSWORD="..."            sign-in for the seeded dev Super Admin (admin@edutrack.example)
