{
  "expo": {
    "name": "EduTrack Staff",
    "slug": "edutrack-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.edutrack.staff",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EduTrack uses your location when you check in or out, to verify that you are at your branch.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "If you turn on check-in reminders, your phone tells EduTrack when you arrive at your branch so it can remind you to check in. EduTrack does not track or store your location history."
      }
    },
    "android": {
      "package": "com.edutrack.staff",
      "adaptiveIcon": {
        "backgroundColor": "#001D31",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001D31",
          "image": "./assets/splash-icon.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#001D31",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EduTrack uses your location when you check in or out, to verify that you are at your branch.",
          "locationAlwaysAndWhenInUsePermission": "If you turn on check-in reminders, your phone tells EduTrack when you arrive at your branch so it can remind you to check in. EduTrack does not track or store your location history.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#001D31",
          "defaultChannel": "default"
        }
      ],
      "expo-task-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "b8453ef2-60c1-438d-ab43-fac2c9741fa6"
      }
    },
    "owner": "ahmednornafics-team"
  }
}
