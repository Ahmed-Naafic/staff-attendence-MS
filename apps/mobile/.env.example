# EduTrack Staff app (Expo). Copy to apps/mobile/.env and set the API address; restart `npx expo start`
# after any change (EXPO_PUBLIC_ values are inlined into the bundle, so never put secrets here).
#
# The EduTrack API origin, reachable FROM THE PHONE: your computer's LAN address and the API port
# (backend PORT, default 4000). Not localhost: on the phone, localhost is the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
