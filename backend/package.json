{
  "name": "@edutrack/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file=.env.dev --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "test": "node --env-file=.env.dev --test --test-concurrency=1 \"test/**/*.test.js\"",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev-branch": "node --env-file=.env.dev ../node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:dev": "node --env-file=.env.dev scripts/seed-dev.js",
    "create-super-admin": "node scripts/create-super-admin.js",
    "create-super-admin:dev-branch": "node --env-file=.env.dev scripts/create-super-admin.js",
    "reset-super-admin-password": "node scripts/reset-super-admin-password.js",
    "reset-super-admin-password:dev-branch": "node --env-file=.env.dev scripts/reset-super-admin-password.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
